# Copie para .env (cp .env.exemplo .env) e preencha. Nunca versione o .env.

# Endereço público do sistema. Sem domínio próprio, use o IP elástico com sslip.io,
# trocando os pontos por traços: 18.220.10.20 -> 18-220-10-20.sslip.io
DOMINIO=18-220-10-20.sslip.io

# Banco RDS (endpoint em RDS > Bancos de dados > wiestoque-db > Conectividade)
DATABASE_URL=jdbc:postgresql://ENDPOINT-DO-RDS:5432/wiestoque?sslmode=require
DATABASE_USER=wiestoque
DATABASE_PASSWORD=TROQUE_PELA_SENHA_DO_RDS

# Só na primeira subida com banco vazio; apague depois de entrar no sistema
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
